## GITATTRIBUTES FOR NEXT.JS PROJECT WITH BUN
#
# Details per file setting:
#   text    Normalized (CRLF -> LF) for consistency across platforms.
#   binary  Left untouched (no normalization or diff).
#   eol=lf  Enforces LF line endings for text files.
#
# Note: 'binary' is a macro for '-text -diff'.
######################################################################

# Auto-detect text files and normalize line endings, leave binaries untouched
*                 text=auto

# Source code
*.css             text eol=lf
*.html            text diff=html eol=lf
*.js              text eol=lf
*.jsx             text eol=lf
*.json            text eol=lf
*.ts              text eol=lf
*.tsx             text eol=lf

# SVG as text (for editing and diffing in a React app)
*.svg             text eol=lf

# Video and audio files (binary)
*.mp4             binary
*.webm            binary
*.mov             binary
*.avi             binary
*.mp3             binary
*.wav             binary

# Animation files (binary)
*.lottie          binary

# Config files
.gitattributes    text eol=lf
.gitignore        text eol=lf
*.yml             text eol=lf
bun.lockb         binary
.npmrc            text eol=lf
.prettierignore   text eol=lf
.browserslistrc   text eol=lf

# Documentation
*.md              text eol=lf

# Graphics (binary)
*.ico             binary
*.jpg             binary
*.png             binary
*.webp            binary

# Fonts (binary)
*.ttf             binary
*.eot             binary
*.otf             binary
*.woff            binary
*.woff2           binary

# RC files (e.g., .eslintrc, .prettierrc)
*.*rc             text eol=lf
