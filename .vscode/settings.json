{
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "cSpell.caseSensitive": true,
  "cSpell.enabledFileTypes": {
    "*": false,
    "css": true,
    "dotenv": true,
    "github-actions-workflow": true,
    "html": true,
    "ignore": true,
    "javascript": true,
    "javascriptreact": true,
    "json": true,
    "jsonc": true,
    "log": true,
    "markdown": true,
    "plaintext": true,
    "properties": true,
    "svg": true,
    "tailwindcss": true,
    "typescript": true,
    "typescriptreact": true,
    "vitest-snapshot": true,
    "xml": true,
    "yaml": true
  },
  "cSpell.ignorePaths": [
    "package-lock.json",
    "node_modules",
    "vscode-extension",
    ".git/{info,lfs,logs,refs,objects}/**",
    ".git/{index,*refs,*HEAD}",
    ".vscode",
    ".vscode-insiders",
    "public"
  ],
  "cSpell.language": "en-US, fa-IR",
  "cSpell.words": [
    "bakh",
    "Bakh",
    "bunx",
    "commitlint",
    "consts",
    "dexie",
    "flexbox",
    "heroui",
    "lockb",
    "nextjs",
    "nextui",
    "nocompatible",
    "packagejson",
    "persian",
    "roboto",
    "tailwindcss",
    "turbopack",
    "wwwords",
    "yekan",
    "zustand"
  ],
  "css.validate": false,
  "editor.autoClosingQuotes": "always",
  "editor.codeActionsOnSave": {
    "source.fixAll": "always",
    "source.organizeImports": "always"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.foldingImportsByDefault": true,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.linkedEditing": true,
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "eslint.lintTask.enable": true,
  "eslint.probe": [
    "javascript",
    "typescript",
    "typescriptreact",
    "json",
    "yaml"
  ],
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "files.eol": "\n",
  "files.exclude": {
    "**/.git": true,
    "**/.next": true,
    "**/.vscode": true,
    "**/node_modules": true
  },
  "files.insertFinalNewline": true,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.next/**": true,
    "**/node_modules/*/**": true
  },
  "findUnusedExports.detectCircularImports": true,
  "git.autoStash": true,
  "git.autofetch": true,
  "git.closeDiffOnOperation": true,
  "git.enableSmartCommit": true,
  "git.repositoryScanIgnoredFolders": [
    "node_modules",
    ".next",
    ".husky",
    ".vscode",
    "types",
    "public",
    "src"
  ],
  "githubIssues.createIssueTriggers": ["TODO", "BUG", "FIX"],
  "githubPullRequests.defaultMergeMethod": "squash",
  "githubPullRequests.ignoredPullRequestBranches": ["main"],
  "javascript.suggestionActions.enabled": false,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "prettier.documentSelectors": [
    "**/*.svg"
  ],
  "search.exclude": {
    "**/.next": true,
    "**/node_modules": true
  },
  "tailwindCSS.experimental.configFile": "src/app/globals.css",
  "tailwindCSS.files.exclude": [
    "**/.git/**",
    "**/node_modules/**",
    "**/.hg/**",
    "**/.next/**"
  ],
  "tailwindCSS.lint.cssConflict": "error",
  "todo-tree.filtering.excludeGlobs": ["node_modules", ".next"],
  "todo-tree.general.automaticGitRefreshInterval": 60,
  "todo-tree.general.tags": ["BUG", "FIX", "TODO"],
  "todo-tree.highlights.backgroundColourScheme": ["red", "orange", "blue"],
  "todo-tree.highlights.foregroundColourScheme": ["white", "white", "white"],
  "todo-tree.highlights.useColourScheme": true,
  "typescript.preferences.quoteStyle": "single",
  "typescript.tsdk": "node_modules/typescript/lib"
}
