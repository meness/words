{
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "autoBarrel.enable": true,
  "autoBarrel.formatting.useSingleQuotes": true,
  "cSpell.enabledFileTypes": {
    "!asciidoc": false,
    "!c": false,
    "!cpp": false,
    "!csharp": false,
    "!go": false,
    "!handlebars": false,
    "!haskell": false,
    "!jade": false,
    "!java": false,
    "!javascriptreact": false,
    "!jupyter": false,
    "!latex": false,
    "!less": false,
    "!php": false,
    "!pug": false,
    "!python": false,
    "!restructuredtext": false,
    "!rust": false,
    "!scala": false,
    "!scss": false,
    "!swift": false,
    "!vue": false,
    "!dockercompose": false,
    "dotenv": true,
    "!git-rebase": false,
    "!graphql": false,
    "ignore": true,
    "log": true,
    "!makefile": false,
    "!shellscript": false,
    "svg": true,
    "tailwindcss": true,
    "toml": true,
    "typescript": true,
    "jsonc": true
  },
  "cSpell.language": "en-US, fa-IR",
  "cSpell.words": [
    "abjad",
    "Addeds",
    "arbitrum",
    "Autorenew",
    "bakh",
    "browserslistrc",
    "bunx",
    "chartjs",
    "codegen",
    "CODEOWNERS",
    "commitlint",
    "consts",
    "copperx",
    "cssnano",
    "Dexie",
    "Dismissable",
    "endregion",
    "flexbox",
    "flexbugs",
    "googletagmanager",
    "Homaun",
    "hookform",
    "ipfs",
    "keccak",
    "listbox",
    "Luganodes",
    "neobase",
    "neue",
    "nextjs",
    "nextui",
    "noopener",
    "noreferrer",
    "nosniff",
    "packagejson",
    "parens",
    "progressbar",
    "rainbowkit",
    "Sepolia",
    "sophon",
    "stylelint",
    "svgr",
    "tailwindcss",
    "tanstack",
    "undelegated",
    "Useds",
    "VERCEL",
    "viem",
    "wagmi",
    "walletconnect",
    "walletlink",
    "webp",
    "wwwords",
    "yekan",
    "zustand"
  ],
  "css.validate": false,
  "editor.autoClosingQuotes": "always",
  "editor.codeActionsOnSave": {
    "source.fixAll": "always",
    "source.organizeImports": "always"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.linkedEditing": true,
  "editor.quickSuggestions": {
    "strings": true
  },
  "eslint.lintTask.enable": true,
  "eslint.probe": ["javascript", "typescript", "typescriptreact"],
  "files.autoSave": "afterDelay",
  "files.eol": "\n",
  "files.exclude": {
    "**/.git": true,
    "**/.vscode": true,
    "**/node_modules": true,
    "**/.next": true
  },
  "files.insertFinalNewline": true,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true,
    "**/.next/**": true
  },
  "git.autoStash": true,
  "git.autofetch": true,
  "git.closeDiffOnOperation": true,
  "git.enableSmartCommit": true,
  "git.repositoryScanIgnoredFolders": [
    "node_modules",
    ".next",
    ".husky",
    ".vscode",
    ".next",
    "types",
    "public",
    "src"
  ],
  "githubIssues.createIssueTriggers": ["TODO", "BUG", "FIX"],
  "githubPullRequests.defaultMergeMethod": "squash",
  "githubPullRequests.ignoredPullRequestBranches": ["main", "staging"],
  "javascript.suggestionActions.enabled": false,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "prettier.documentSelectors": ["**/*.svg"],
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true
  },
  "tailwindCSS.files.exclude": [
    "**/.git/**",
    "**/node_modules/**",
    "**/.hg/**",
    "**/.next/**"
  ],
  "todo-tree.filtering.excludeGlobs": ["node_modules", ".next"],
  "todo-tree.general.automaticGitRefreshInterval": 60,
  "todo-tree.general.tags": ["BUG", "FIX", "TODO"],
  "todo-tree.highlights.backgroundColourScheme": ["red", "orange", "blue"],
  "todo-tree.highlights.foregroundColourScheme": ["white", "white", "white"],
  "todo-tree.highlights.useColourScheme": true,
  "typescript.preferences.quoteStyle": "single",
  "typescript.tsdk": "node_modules/typescript/lib"
}
